#!/usr/bin/env @PYTHON@
"""Installed Hosty launcher (generated by Meson)."""

import os
import signal
import sys

pkgdatadir = "@pkgdatadir@"
localedir = "@localedir@"

# The Python package is installed under the package data directory.
if os.path.isdir(pkgdatadir):
    sys.path.insert(1, pkgdatadir)

os.environ.setdefault("HOSTY_LOCALEDIR", localedir)
signal.signal(signal.SIGINT, signal.SIG_DFL)

from hosty.main import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
